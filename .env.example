NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retzetar
CLIENT_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AI_PROVIDER=openai
AI_API_KEY=
AI_VISION_MODEL=gpt-4o-mini-2024-07-18
# Required for AI_PROVIDER=openai-compatible, e.g. https://vendor.example/v1
# AI_BASE_URL=
VITE_API_URL=http://localhost:3000

# LAN development: replace the address with the host's LAN IPv4 address.
# CLIENT_ORIGIN=http://192.168.1.128:5173
# BETTER_AUTH_URL=http://192.168.1.128:3000
# Leave VITE_API_URL unset so the web app uses the same hostname as the page.
