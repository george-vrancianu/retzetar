    "db:generate": "npm run db:generate --workspace=@retzetar/api",
    "db:migrate": "npm run db:migrate --workspace=@retzetar/api",
    "db:push": "npm run db:push --workspace=@retzetar/api",
    "db:studio": "npm run db:studio --workspace=@retzetar/api",
    "db:seed": "npm run db:seed --workspace=@retzetar/api"
  },
